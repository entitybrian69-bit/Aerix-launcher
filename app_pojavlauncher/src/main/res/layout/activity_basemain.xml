<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_height="match_parent"
	android:layout_width="match_parent"
	android:layout_alignParentRight="true"
	android:id="@+id/main_drawer_options"
	android:background="@drawable/no_focus_shown"
	android:keepScreenOn="true">

	<FrameLayout
		android:id="@+id/content_frame"
		android:layout_width="match_parent"
		android:layout_height="match_parent">

		<net.kdt.pojavlaunch.customcontrols.ControlLayout
			android:id="@+id/main_control_layout"
			android:layout_width="match_parent"
			android:layout_height="match_parent">

			<net.kdt.pojavlaunch.game.GameView
				android:id="@+id/main_game_render_view"
				android:layout_width="fill_parent"
				android:layout_height="fill_parent"
				android:defaultFocusHighlightEnabled="false"
                tools:ignore="UnusedAttribute">

				<net.kdt.pojavlaunch.game.GameCursorView
					android:layout_height="match_parent"
					android:layout_width="match_parent"
					android:orientation="vertical"
					android:id="@+id/main_cursorview"
					android:focusable="false"
					android:translationZ="1dp"
					android:visibility="gone"
					app:defaultCursorDrawable="@drawable/ic_mouse_pointer"/>

			</net.kdt.pojavlaunch.game.GameView>


			<net.kdt.pojavlaunch.customcontrols.keyboard.TouchCharInput
				android:id="@+id/mainTouchCharInput"
				android:layout_width="1dp"
				android:layout_height="1dp"
				android:background="@android:color/darker_gray"
				android:ems="10"
				android:imeOptions="flagNoFullscreen|flagNoExtractUi|flagNoPersonalizedLearning|actionDone"
				android:inputType="textFilter|textImeMultiLine|textAutoComplete|textAutoCorrect"
				tools:ignore="TouchTargetSizeCheck" />

			<!-- Size and position are driven by DrawerPullButton itself, so the button keeps the
			     place the player dragged it to. -->
			<net.kdt.pojavlaunch.customcontrols.handleview.DrawerPullButton
				android:id="@+id/drawer_button"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:elevation="10dp"
				android:layout_gravity="top|start"/>
			<net.kdt.pojavlaunch.customcontrols.mouse.HotbarView
				android:id="@+id/hotbar_view"
				android:layout_width="0px"
				android:layout_height="0px"/>

		</net.kdt.pojavlaunch.customcontrols.ControlLayout>

		<!--
			The loading screen. Deliberately empty apart from a spinner: no title, no warning text,
			no buttons. The wallpaper is drawn into this frame from code when the player has turned
			it on in the in-game menu; until then it is opaque black, which is the default.
		-->
		<FrameLayout
			android:id="@+id/main_loading_screen"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:background="#FF000000"
			android:visibility="visible"
			>

			<ProgressBar
				android:id="@+id/main_loading_screen_progress"
				android:layout_width="24dp"
				android:layout_height="24dp"
				android:layout_gravity="center"
				android:indeterminate="true" />
		</FrameLayout>

		<!-- The in game menu: a full screen Compose overlay, hidden until the button opens it.
		     It is composed once and stays out of the way (and out of the frame budget) while the
		     game runs. -->
		<net.kdt.pojavlaunch.aerix.ui.game.GameMenuOverlayView
			android:id="@+id/game_menu_overlay"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:visibility="gone" />

		<net.kdt.pojavlaunch.game.FpsView
			android:id="@+id/main_fps_view"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="top|start"
			android:layout_marginStart="8dp"
			android:layout_marginTop="6dp"
			android:paddingStart="7dp"
			android:paddingEnd="7dp"
			android:paddingTop="2dp"
			android:paddingBottom="2dp"
			android:visibility="gone" />

		<com.kdt.LoggerView
			android:id="@+id/mainLoggerView"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:visibility="gone"
			/>

	</FrameLayout>

	<ListView
		android:layout_width="200dp"
		android:layout_height="match_parent"
		android:layout_gravity="right"
		android:background="?attr/colorBackgroundFloating"
		android:fitsSystemWindows="false"
		android:id="@+id/main_navigation_view"/>

</androidx.drawerlayout.widget.DrawerLayout>

