<?xml version="1.0" encoding="utf-8"?>
<!-- Wallpapers: the launcher backdrop, or a picture from the device. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/mirai_space_xxl">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/mirai_wallpaper_title"
        android:textColor="?attr/miraiOnSurface"
        android:textSize="22sp"
        android:textStyle="bold"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/mirai_space_xs"
        android:text="@string/mirai_wallpaper_summary"
        android:textColor="?attr/miraiOnSurfaceVariant"
        android:textSize="13sp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/mirai_space_xl"
        android:orientation="horizontal">

        <Button
            android:id="@+id/wallpaper_pick"
            android:layout_width="0dp"
            android:layout_height="@dimen/mirai_shell_action_height"
            android:layout_marginEnd="@dimen/mirai_space_sm"
            android:layout_weight="1"
            android:background="@drawable/mirai_button"
            android:text="@string/mirai_wallpaper_pick"
            android:textColor="?attr/miraiOnPrimary"/>

        <Button
            android:id="@+id/wallpaper_clear"
            android:layout_width="0dp"
            android:layout_height="@dimen/mirai_shell_action_height"
            android:layout_marginStart="@dimen/mirai_space_sm"
            android:layout_weight="1"
            android:background="@drawable/mirai_button_outline"
            android:text="@string/mirai_wallpaper_none"
            android:textColor="?attr/miraiOnSurface"/>

    </LinearLayout>

    <ImageView
        android:id="@+id/wallpaper_preview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/mirai_space_xl"
        android:layout_weight="1"
        android:background="@drawable/mirai_card"
        android:contentDescription="@string/mirai_wallpaper_title"
        android:padding="@dimen/mirai_space_xs"
        android:scaleType="centerCrop"/>

</LinearLayout>
