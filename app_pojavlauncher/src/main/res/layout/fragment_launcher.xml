<?xml version="1.0" encoding="utf-8"?>
<!-- Home, Mirai style, single column for upright screens. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:overScrollMode="never"
    android:padding="@dimen/mirai_space_lg"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/mirai_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/mirai_space_lg">

            <ImageView
                android:id="@+id/liquid_instance_icon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/mirai_rail_pill"
                android:contentDescription="@string/liquid_selected_instance"
                android:padding="16dp"
                android:src="@drawable/ic_px_home"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/mirai_space_lg"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.kdt.mcgui.mcVersionSpinner
                    android:id="@+id/mc_version_spinner"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@android:color/transparent"
                    android:drawablePadding="@dimen/mirai_space_xs"
                    android:drawableEnd="@drawable/ic_expand_more"
                    android:gravity="center_vertical"
                    android:textColor="?attr/miraiOnSurface"
                    android:textSize="16sp"/>

                <TextView
                    android:id="@+id/liquid_instance_detail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/liquid_instance_default"
                    android:textColor="?attr/miraiOnSurfaceVariant"
                    android:textSize="12sp"/>

            </LinearLayout>

            <ImageButton
                android:id="@+id/edit_profile_button"
                android:layout_width="@dimen/mirai_shell_action_height"
                android:layout_height="@dimen/mirai_shell_action_height"
                android:background="@drawable/mirai_button_outline"
                android:contentDescription="@string/global_edit"
                android:padding="8dp"
                android:src="@drawable/ic_px_edit"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mirai_space_lg"
            android:background="@drawable/mirai_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/mirai_space_xxl">

            <ImageView
                android:id="@+id/liquid_launch_ring"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/mirai_launch_glow"/>

            <Button
                android:id="@+id/play_button"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:background="@drawable/mirai_button"
                android:drawableStart="@drawable/ic_px_home"
                android:drawablePadding="@dimen/mirai_space_md"
                android:paddingStart="@dimen/mirai_space_xl"
                android:paddingEnd="@dimen/mirai_space_xl"
                android:text="@string/liquid_launch"
                android:textColor="?attr/miraiOnPrimary"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mirai_space_md"
                android:text="@string/liquid_launch_hint"
                android:textColor="?attr/miraiOnSurfaceVariant"
                android:textSize="13sp"/>

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mirai_space_xxl"
            android:layout_marginBottom="@dimen/mirai_space_md"
            android:letterSpacing="0.08"
            android:text="@string/liquid_quick_actions"
            android:textAllCaps="true"
            android:textColor="?attr/miraiOutline"
            android:textSize="11sp"
            android:textStyle="bold"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/custom_control_button"
                style="@style/Mirai.Button.Outline"
                android:layout_width="0dp"
                android:layout_height="@dimen/mirai_quick_action_height"
                android:layout_marginEnd="@dimen/mirai_space_sm"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_px_gamepad"
                android:text="@string/mcl_option_customcontrol"/>

            <Button
                android:id="@+id/install_jar_button"
                style="@style/Mirai.Button.Outline"
                android:layout_width="0dp"
                android:layout_height="@dimen/mirai_quick_action_height"
                android:layout_marginStart="@dimen/mirai_space_sm"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_px_java_run"
                android:text="@string/main_install_jar_file"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mirai_space_md"
            android:orientation="horizontal">

            <Button
                android:id="@+id/share_logs_button"
                style="@style/Mirai.Button.Outline"
                android:layout_width="0dp"
                android:layout_height="@dimen/mirai_quick_action_height"
                android:layout_marginEnd="@dimen/mirai_space_sm"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_px_sharelog"
                android:text="@string/main_share_logs"/>

            <Button
                android:id="@+id/open_files_button"
                style="@style/Mirai.Button.Outline"
                android:layout_width="0dp"
                android:layout_height="@dimen/mirai_quick_action_height"
                android:layout_marginStart="@dimen/mirai_space_sm"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_px_folder"
                android:text="@string/mcl_button_open_directory"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mirai_space_md"
            android:orientation="horizontal">

            <Button
                android:id="@+id/news_button"
                style="@style/Mirai.Button.Outline"
                android:layout_width="0dp"
                android:layout_height="@dimen/mirai_quick_action_height"
                android:layout_marginEnd="@dimen/mirai_space_sm"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_px_book"
                android:text="@string/mcl_tab_wiki"/>

            <Button
                android:id="@+id/social_media_button"
                style="@style/Mirai.Button.Outline"
                android:layout_width="0dp"
                android:layout_height="@dimen/mirai_quick_action_height"
                android:layout_marginStart="@dimen/mirai_space_sm"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_social_media"
                android:text="@string/mcl_button_social_media"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
