<?xml version="1.0" encoding="utf-8"?>
<!-- LAUNCH tab (portrait).

     Same features as before, re-imagined: the instance picker became a hero
     card, the play bar became a launch crystal, the stacked menu buttons
     became a quick action grid. Every id used by MainMenuFragment is kept. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:overScrollMode="never"
    android:paddingStart="@dimen/liquid_pad_large"
    android:paddingEnd="@dimen/liquid_pad_large"
    android:paddingTop="@dimen/liquid_pad"
    android:paddingBottom="@dimen/_120sdp"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Selected instance  -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/liquid_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/liquid_pad"
            android:paddingTop="@dimen/liquid_pad"
            android:paddingEnd="@dimen/liquid_gap"
            android:paddingBottom="@dimen/liquid_pad">

            <FrameLayout
                android:layout_width="@dimen/_72sdp"
                android:layout_height="@dimen/_72sdp">

                <ImageView
                    android:id="@+id/liquid_instance_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/liquid_orb"
                    android:contentDescription="@string/liquid_selected_instance"
                    android:padding="@dimen/_18sdp"
                    android:src="@drawable/ic_px_home"/>

            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/liquid_gap_large"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.kdt.mcgui.mcVersionSpinner
                    android:id="@+id/mc_version_spinner"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_40sdp"
                    android:background="@android:color/transparent"
                    android:drawablePadding="@dimen/liquid_gap"
                    android:drawableEnd="@drawable/ic_expand_more"
                    android:gravity="center_vertical"
                    android:textColor="@color/liquid_ink"
                    android:textSize="@dimen/_15ssp"/>

                <TextView
                    android:id="@+id/liquid_instance_detail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:fontFamily="@font/noto_sans_bold"
                    android:text="@string/liquid_instance_default"
                    android:textColor="@color/liquid_dim"
                    android:textSize="@dimen/_10ssp"/>

            </LinearLayout>

            <ImageButton
                android:id="@+id/edit_profile_button"
                android:layout_width="@dimen/liquid_touch_min"
                android:layout_height="@dimen/liquid_touch_min"
                android:background="@drawable/liquid_orb"
                android:contentDescription="@string/global_edit"
                android:src="@drawable/ic_px_edit"
                android:padding="@dimen/_18sdp"/>

        </LinearLayout>

        <!-- Launch crystal  -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/liquid_gap_large"
            android:background="@drawable/liquid_card"
            android:paddingTop="@dimen/liquid_pad_large"
            android:paddingBottom="@dimen/liquid_pad_large">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="@dimen/_180sdp"
                    android:layout_height="@dimen/_180sdp"
                    android:layout_gravity="center_horizontal">

                    <View
                        android:id="@+id/liquid_launch_ring"
                        android:layout_width="@dimen/_212sdp"
                        android:layout_height="@dimen/_212sdp"
                        android:layout_gravity="center"
                        android:background="@drawable/liquid_ring"/>

                    <Button
                        android:id="@+id/play_button"
                        android:layout_width="@dimen/_180sdp"
                        android:layout_height="@dimen/_180sdp"
                        android:layout_gravity="center"
                        android:background="@drawable/liquid_launch_orb"
                        android:fontFamily="@font/noto_sans_bold"
                        android:letterSpacing="0.18"
                        android:text="@string/liquid_launch"
                        android:textAllCaps="true"
                        android:textColor="#06121C"
                        android:textSize="@dimen/_15ssp"/>

                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/liquid_pad"
                    android:fontFamily="@font/noto_sans_bold"
                    android:letterSpacing="0.12"
                    android:text="@string/liquid_instance_default"
                    android:textColor="@color/liquid_dim"
                    android:textSize="@dimen/_10ssp"
                    tools:ignore="TextContrastCheck"/>

            </LinearLayout>

        </FrameLayout>

        <!-- Quick actions  -->
        <TextView
            style="@style/LiquidSectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/liquid_pad_large"
            android:layout_marginBottom="@dimen/liquid_gap"
            android:text="@string/liquid_quick_actions"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/custom_control_button"
                style="@style/LiquidQuickAction"
                android:layout_width="0dp"
                android:layout_height="@dimen/_92sdp"
                android:layout_marginEnd="@dimen/liquid_gap"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_px_gamepad"
                android:text="@string/mcl_option_customcontrol"/>

            <Button
                android:id="@+id/install_jar_button"
                style="@style/LiquidQuickAction"
                android:layout_width="0dp"
                android:layout_height="@dimen/_92sdp"
                android:layout_marginStart="@dimen/liquid_gap"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_px_java_run"
                android:text="@string/main_install_jar_file"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/liquid_gap"
            android:orientation="horizontal">

            <Button
                android:id="@+id/share_logs_button"
                style="@style/LiquidQuickAction"
                android:layout_width="0dp"
                android:layout_height="@dimen/_92sdp"
                android:layout_marginEnd="@dimen/liquid_gap"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_px_sharelog"
                android:text="@string/main_share_logs"/>

            <Button
                android:id="@+id/open_files_button"
                style="@style/LiquidQuickAction"
                android:layout_width="0dp"
                android:layout_height="@dimen/_92sdp"
                android:layout_marginStart="@dimen/liquid_gap"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_px_folder"
                android:text="@string/mcl_button_open_directory"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/liquid_gap"
            android:orientation="horizontal">

            <Button
                android:id="@+id/news_button"
                style="@style/LiquidQuickAction"
                android:layout_width="0dp"
                android:layout_height="@dimen/_92sdp"
                android:layout_marginEnd="@dimen/liquid_gap"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_px_book"
                android:text="@string/mcl_tab_wiki"/>

            <Button
                android:id="@+id/social_media_button"
                style="@style/LiquidQuickAction"
                android:layout_width="0dp"
                android:layout_height="@dimen/_92sdp"
                android:layout_marginStart="@dimen/liquid_gap"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_social_media"
                android:text="@string/mcl_button_social_media"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
