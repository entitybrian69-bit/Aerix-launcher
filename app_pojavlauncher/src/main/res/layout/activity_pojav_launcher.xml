<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/aerix_backdrop">

    <ImageView
        android:id="@+id/launcher_wallpaper_backdrop"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0.38"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/launcher_wallpaper_shade"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#550A1220"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/aerix_navigation_rail"
        android:layout_width="72dp"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/aerix_rail_background"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="8dp"
        android:paddingVertical="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/aerix_wordmark"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:letterSpacing="0.11"
            android:text="AERIX"
            android:textColor="#D8E9FA"
            android:textSize="10sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="false"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/home_nav_button"
                    style="@style/AerixNavigationButton"
                    android:contentDescription="@string/aerix_navigation_home"
                    android:src="@drawable/ic_px_home"
                    tools:ignore="HardcodedText" />

                <ImageButton
                    android:id="@+id/create_nav_button"
                    style="@style/AerixNavigationButton"
                    android:contentDescription="@string/aerix_navigation_create"
                    android:src="@drawable/ic_px_dynamic"
                    tools:ignore="HardcodedText" />

                <ImageButton
                    android:id="@+id/library_nav_button"
                    style="@style/AerixNavigationButton"
                    android:contentDescription="@string/aerix_navigation_library"
                    android:src="@drawable/ic_px_file"
                    tools:ignore="HardcodedText" />

                <ImageButton
                    android:id="@+id/discover_nav_button"
                    style="@style/AerixNavigationButton"
                    android:contentDescription="@string/aerix_navigation_discover"
                    android:src="@drawable/ic_modrinth"
                    tools:ignore="HardcodedText" />

                <ImageButton
                    android:id="@+id/wallpapers_nav_button"
                    style="@style/AerixNavigationButton"
                    android:contentDescription="@string/aerix_navigation_wallpapers"
                    android:src="@drawable/ic_px_image"
                    tools:ignore="HardcodedText" />

                <ImageButton
                    android:id="@+id/servers_nav_button"
                    style="@style/AerixNavigationButton"
                    android:contentDescription="@string/aerix_navigation_servers"
                    android:src="@drawable/ic_px_console"
                    tools:ignore="HardcodedText" />
            </LinearLayout>
        </ScrollView>

        <ImageButton
            android:id="@+id/setting_button"
            style="@style/AerixNavigationButton"
            android:contentDescription="@string/aerix_navigation_settings"
            android:src="@drawable/ic_px_sliders"
            tools:ignore="HardcodedText" />

        <com.kdt.mcgui.AccountSpinner
            android:id="@+id/account_spinner"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:dropDownWidth="250dp"
            android:dropDownVerticalOffset="0dp"
            android:gravity="center"
            android:padding="2dp"
            tools:ignore="RtlSymmetry" />
    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/launcher_content_panel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/aerix_navigation_rail"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/container_fragment"
            android:name="net.kdt.pojavlaunch.fragments.MainMenuFragment"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@android:color/transparent"
            app:layout_constraintBottom_toTopOf="@id/progress_layout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.kdt.mcgui.ProgressLayout
            android:id="@+id/progress_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
