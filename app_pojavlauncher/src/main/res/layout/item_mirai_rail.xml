<?xml version="1.0" encoding="utf-8"?>
<!-- One Mirai rail entry: a glass tile with an icon, accent filled when selected. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/mirai_rail_item_width"
    android:layout_height="@dimen/mirai_rail_item_height"
    android:layout_marginBottom="@dimen/mirai_gap_sm"
    android:background="@drawable/glass_item"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/rail_slot_icon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="center"
        android:duplicateParentState="true"
        android:src="@drawable/ic_home_filled"/>

</FrameLayout>
