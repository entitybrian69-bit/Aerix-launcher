<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/mirai_space_md"
    android:paddingEnd="@dimen/mirai_space_md">

    <ImageView
        android:id="@+id/instance_row_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/mirai_rail_pill"
        android:contentDescription="@string/liquid_selected_instance"
        android:padding="10dp"
        android:src="@drawable/ic_px_home"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/mirai_space_md"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/instance_row_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="?attr/miraiOnSurface"
            android:textSize="15sp"
            tools:text="1.21.4 Fabric"/>

        <TextView
            android:id="@+id/instance_row_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="?attr/miraiOnSurfaceVariant"
            android:textSize="12sp"
            tools:text="Fabric Loader 0.16.9"/>

    </LinearLayout>

    <ImageButton
        android:id="@+id/instance_row_edit"
        android:layout_width="@dimen/mirai_shell_action_height"
        android:layout_height="@dimen/mirai_shell_action_height"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/global_edit"
        android:padding="8dp"
        android:src="@drawable/ic_px_edit"/>

    <ImageButton
        android:id="@+id/instance_row_delete"
        android:layout_width="@dimen/mirai_shell_action_height"
        android:layout_height="@dimen/mirai_shell_action_height"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/global_delete"
        android:padding="8dp"
        android:src="@drawable/ic_px_trash"/>

</LinearLayout>
