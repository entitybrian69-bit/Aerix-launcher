<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/aerix_backdrop">

    <ImageView android:id="@+id/launcher_wallpaper_backdrop" android:layout_width="0dp"
        android:layout_height="0dp" android:scaleType="centerCrop" android:visibility="gone"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <View android:layout_width="0dp" android:layout_height="0dp" android:background="#1905142D"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout android:id="@+id/prism_top_bar" android:layout_width="0dp"
        android:layout_height="54dp" android:layout_marginHorizontal="16dp" android:layout_marginTop="12dp"
        android:background="@drawable/prism_bar" android:gravity="center_vertical"
        android:orientation="horizontal" android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="◆" android:textColor="#A5EAFF" android:textSize="24sp"
            android:contentDescription="@string/app_name" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="12dp" android:text="AERIX" android:textStyle="bold"
            android:letterSpacing="0.1" android:textColor="#F0F9FF" android:textSize="13sp" />
        <TextView android:id="@+id/prism_page_title" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="16dp"
            android:ellipsize="end" android:maxLines="1" android:text="@string/aerix_nav_home_label"
            android:textColor="#D8EAF8" android:textSize="14sp" />
        <TextView android:id="@+id/prism_search_button" android:layout_width="110dp"
            android:layout_height="40dp" android:background="@drawable/aerix_nav_button"
            android:gravity="center_vertical" android:paddingHorizontal="12dp"
            android:text="@string/prism_search" android:textColor="#D8ECFA" android:textSize="12sp" />
        <ImageButton android:id="@+id/account_nav_button" style="@style/PrismTopIcon"
            android:layout_marginStart="10dp" android:contentDescription="@string/aerix_navigation_account"
            android:src="@drawable/ic_aerix_account" />
        <ImageButton android:id="@+id/setting_button" style="@style/PrismTopIcon"
            android:layout_marginStart="4dp" android:contentDescription="@string/aerix_navigation_settings"
            android:src="@drawable/ic_px_sliders" />
    </LinearLayout>

    <LinearLayout android:id="@+id/prism_dock" android:layout_width="wrap_content"
        android:layout_height="56dp" android:layout_marginBottom="12dp"
        android:background="@drawable/prism_bar" android:gravity="center_vertical"
        android:orientation="horizontal" android:paddingHorizontal="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
            <LinearLayout android:layout_width="68dp" android:layout_height="match_parent"
                android:gravity="center" android:orientation="vertical">
                <ImageButton android:id="@+id/home_nav_button" style="@style/PrismDockIcon"
                    android:contentDescription="@string/aerix_navigation_home" android:src="@drawable/ic_px_home" />
                <TextView android:id="@+id/home_nav_label" style="@style/PrismDockLabel"
                    android:text="@string/aerix_nav_home_label" />
            </LinearLayout>
            <LinearLayout android:layout_width="68dp" android:layout_height="match_parent"
                android:gravity="center" android:orientation="vertical">
                <ImageButton android:id="@+id/create_nav_button" style="@style/PrismDockIcon"
                    android:contentDescription="@string/aerix_navigation_create" android:src="@drawable/ic_px_dynamic" />
                <TextView android:id="@+id/create_nav_label" style="@style/PrismDockLabel"
                    android:text="@string/aerix_nav_create_label" />
            </LinearLayout>
            <LinearLayout android:layout_width="68dp" android:layout_height="match_parent"
                android:gravity="center" android:orientation="vertical">
                <ImageButton android:id="@+id/library_nav_button" style="@style/PrismDockIcon"
                    android:contentDescription="@string/aerix_navigation_library" android:src="@drawable/ic_px_file" />
                <TextView android:id="@+id/library_nav_label" style="@style/PrismDockLabel"
                    android:text="@string/aerix_nav_library_label" />
            </LinearLayout>
            <LinearLayout android:layout_width="68dp" android:layout_height="match_parent"
                android:gravity="center" android:orientation="vertical">
                <ImageButton android:id="@+id/discover_nav_button" style="@style/PrismDockIcon"
                    android:contentDescription="@string/aerix_navigation_discover" android:src="@drawable/ic_modrinth" />
                <TextView android:id="@+id/discover_nav_label" style="@style/PrismDockLabel"
                    android:text="@string/aerix_nav_discover_label" />
            </LinearLayout>
            <LinearLayout android:layout_width="68dp" android:layout_height="match_parent"
                android:gravity="center" android:orientation="vertical">
                <ImageButton android:id="@+id/skins_nav_button" style="@style/PrismDockIcon"
                    android:contentDescription="@string/aerix_navigation_skins" android:src="@drawable/ic_edit_profile" />
                <TextView android:id="@+id/skins_nav_label" style="@style/PrismDockLabel"
                    android:text="@string/prism_studio" />
            </LinearLayout>
        <ImageButton android:id="@+id/prism_more_button" style="@style/PrismTopIcon"
            android:layout_width="40dp" android:layout_height="40dp"
            android:contentDescription="@string/prism_more" android:src="@drawable/prism_ic_more" />
    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/launcher_content_panel"
        android:layout_width="0dp" android:layout_height="0dp"
        android:layout_marginHorizontal="16dp" android:layout_marginVertical="8dp"
        app:layout_constraintTop_toBottomOf="@id/prism_top_bar"
        app:layout_constraintBottom_toTopOf="@id/prism_dock"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <androidx.fragment.app.FragmentContainerView android:id="@+id/container_fragment"
            android:name="net.kdt.pojavlaunch.fragments.MainMenuFragment"
            android:layout_width="match_parent" android:layout_height="0dp"
            android:background="@android:color/transparent"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toTopOf="@id/progress_layout" />
        <com.kdt.mcgui.ProgressLayout android:id="@+id/progress_layout"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:visibility="gone" app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Nonvisual auth dispatcher and routes remain available to the floating More menu. -->
    <FrameLayout android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent">
        <ImageButton android:id="@+id/wallpapers_nav_button" android:layout_width="1dp" android:layout_height="1dp" />
        <ImageButton android:id="@+id/servers_nav_button" android:layout_width="1dp" android:layout_height="1dp" />
        <com.kdt.mcgui.AccountSpinner android:id="@+id/account_spinner"
            android:layout_width="1dp" android:layout_height="1dp" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
