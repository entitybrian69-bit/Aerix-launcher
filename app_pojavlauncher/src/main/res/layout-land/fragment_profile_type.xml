<?xml version="1.0" encoding="utf-8"?>
<com.kdt.DefocusableScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:clipToPadding="false" android:scrollbars="none"
    android:background="@android:color/transparent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingHorizontal="12dp"
        android:paddingTop="6dp" android:paddingBottom="80dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/prism_create_workbench" android:textSize="28sp"
            android:textColor="#162C41" android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:orientation="horizontal"
            android:baselineAligned="false">
            <LinearLayout android:id="@+id/create_vanilla_panel"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1.05" android:layout_marginEnd="5dp"
                android:background="@drawable/aerix_panel_background"
                android:orientation="vertical" android:padding="11dp">
                <TextView android:id="@+id/title_textview" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="@string/create_profile_vanilla_like_versions"
                    android:textColor="#152D42" android:textSize="15sp" android:textStyle="bold" />
                <ImageView android:layout_width="match_parent" android:layout_height="115dp"
                    android:layout_marginTop="7dp" android:scaleType="centerCrop"
                    android:src="@drawable/prism_cover_river"
                    android:contentDescription="@string/prism_cover_illustration" />
                <Button android:id="@+id/vanilla_profile" android:layout_width="match_parent"
                    android:layout_height="45dp" android:layout_marginTop="8dp"
                    android:text="@string/create_instance_vanilla" android:textAllCaps="false" />
            </LinearLayout>
            <LinearLayout android:id="@+id/create_modded_panel"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1.14" android:layout_marginHorizontal="5dp"
                android:background="@drawable/aerix_panel_background"
                android:orientation="vertical" android:padding="11dp">
                <TextView android:id="@+id/title_modded_textview" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="@string/create_profile_modded_versions"
                    android:textColor="#152D42" android:textSize="15sp" android:textStyle="bold" />
                <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="7dp" android:columnCount="2" android:alignmentMode="alignMargins">
                    <Button android:id="@+id/modded_profile_fabric" style="@style/PrismCreateChip"
                        android:text="Fabric" />
                    <Button android:id="@+id/modded_profile_forge" style="@style/PrismCreateChip"
                        android:text="Forge" />
                    <Button android:id="@+id/modded_profile_neoforge" style="@style/PrismCreateChip"
                        android:text="NeoForge" />
                    <Button android:id="@+id/modded_profile_quilt" style="@style/PrismCreateChip"
                        android:text="Quilt" />
                    <Button android:id="@+id/modded_profile_legacy_fabric" style="@style/PrismCreateChip"
                        android:text="Legacy Fabric" />
                </GridLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/create_modpack_panel"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="0.94" android:layout_marginStart="5dp"
                android:background="@drawable/aerix_panel_background"
                android:orientation="vertical" android:padding="11dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/prism_modpack_import" android:textColor="#152D42"
                    android:textSize="15sp" android:textStyle="bold" />
                <Button android:id="@+id/create_modrinth_button" style="@style/PrismCreateSideButton"
                    android:layout_marginTop="8dp" android:text="Modrinth" />
                <Button android:id="@+id/create_curseforge_button" style="@style/PrismCreateSideButton"
                    android:layout_marginTop="5dp" android:text="CurseForge" />
                <Button android:id="@+id/modded_profile_modpack" style="@style/PrismCreateSideButton"
                    android:layout_marginTop="5dp" android:text="@string/prism_all_modpacks" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:orientation="horizontal">
                    <Button android:id="@+id/optifine_profile" style="@style/PrismCreateChip"
                        android:text="OptiFine" />
                    <Button android:id="@+id/modded_profile_bta" style="@style/PrismCreateChip"
                        android:text="BTA" android:contentDescription="@string/create_bta_instance" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.kdt.DefocusableScrollView>
