<?xml version="1.0" encoding="utf-8"?>
<com.kdt.DefocusableScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/fragment_padding_medium"
        android:paddingTop="@dimen/padding_medium"
        android:paddingBottom="@dimen/padding_large">

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" android:text="@string/prism_create_title"
            android:textColor="#F3FAFF" android:textSize="28sp" android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/create_vanilla_panel"
            android:background="@drawable/aerix_panel_background"
            android:orientation="vertical"
            android:padding="@dimen/padding_large">

            <TextView
                android:id="@+id/title_textview"
                style="@style/TextAppearance.AppCompat.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/create_profile_vanilla_like_versions" />

            <View
                android:id="@+id/view"
                style="@style/ThickDivider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/padding_medium" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_medium"
                android:orientation="horizontal">

                <com.kdt.mcgui.MineButton
                    android:id="@+id/vanilla_profile"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_marginEnd="@dimen/padding_small"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/create_instance_vanilla" />

                <com.kdt.mcgui.MineButton
                    android:id="@+id/optifine_profile"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="@dimen/padding_small"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/mod_dl_install_optifine" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_medium"
            android:id="@+id/create_modded_panel"
            android:background="@drawable/aerix_panel_background"
            android:orientation="vertical"
            android:padding="@dimen/padding_large">

            <TextView
                android:id="@+id/title_modded_textview"
                style="@style/TextAppearance.AppCompat.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/create_profile_modded_versions" />

            <View
                android:id="@+id/view_modded"
                style="@style/ThickDivider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/padding_medium" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_medium"
                android:alignmentMode="alignMargins"
                android:columnCount="2"
                android:useDefaultMargins="false">

                <com.kdt.mcgui.MineButton
                    android:id="@+id/modded_profile_fabric"
                    android:layout_width="0dp"
                    android:layout_height="62dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/padding_small"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/modloader_dl_install_fabric_instance" />

                <com.kdt.mcgui.MineButton
                    android:id="@+id/modded_profile_quilt"
                    android:layout_width="0dp"
                    android:layout_height="62dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/padding_small"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/modloader_dl_install_quilt_instance" />

                <com.kdt.mcgui.MineButton
                    android:id="@+id/modded_profile_legacy_fabric"
                    android:layout_width="0dp"
                    android:layout_height="62dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/padding_small"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/modloader_dl_install_legacy_fabric_instance" />

                <com.kdt.mcgui.MineButton
                    android:id="@+id/modded_profile_forge"
                    android:layout_width="0dp"
                    android:layout_height="62dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/padding_small"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/modloader_dl_install_forge_instance" />

                <com.kdt.mcgui.MineButton
                    android:id="@+id/modded_profile_neoforge"
                    android:layout_width="0dp"
                    android:layout_height="62dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/padding_small"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/modloader_dl_install_neoforge_instance" />

                <com.kdt.mcgui.MineButton
                    android:id="@+id/modded_profile_modpack"
                    android:layout_width="0dp"
                    android:layout_height="62dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/padding_small"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/modpack_install_instance_button" />

                <com.kdt.mcgui.MineButton
                    android:id="@+id/modded_profile_bta"
                    android:layout_width="0dp"
                    android:layout_height="62dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/padding_small"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/create_bta_instance" />
            </GridLayout>
        </LinearLayout>
    </LinearLayout>
</com.kdt.DefocusableScrollView>
