<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <corners android:radius="15dp" />
            <solid android:color="#9230D7DA" />
            <stroke android:width="1dp" android:color="#E6F8FFFF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="15dp" />
            <solid android:color="#7830B9D2" />
            <stroke android:width="1dp" android:color="#A8E7F6FF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="15dp" />
            <solid android:color="#45152740" />
            <stroke android:width="1dp" android:color="#71DDF1FF" />
        </shape>
    </item>
</selector>
