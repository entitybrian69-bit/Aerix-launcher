<?xml version="1.0" encoding="utf-8"?>
<!-- One rail entry: glass until it is selected, then the accent. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/mirai_accent"/>
            <corners android:radius="@dimen/mirai_radius_control"/>
            <stroke android:width="@dimen/mirai_gap_hairline" android:color="@color/mirai_accent"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/mirai_panel"/>
            <corners android:radius="@dimen/mirai_radius_control"/>
            <stroke android:width="@dimen/mirai_gap_hairline" android:color="@color/mirai_border_soft"/>
        </shape>
    </item>
</selector>
