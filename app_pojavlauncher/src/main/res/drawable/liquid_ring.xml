<?xml version="1.0" encoding="utf-8"?>
<!-- The sweep ring behind the launch crystal. It is static here, the fragment
     rotates the view, because animated-rotate needs private framework attrs. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="ring"
    android:innerRadiusRatio="2.6"
    android:thicknessRatio="30"
    android:useLevel="false">
    <gradient
        android:type="sweep"
        android:startColor="#006EF0FF"
        android:centerColor="#806EF0FF"
        android:centerY="0.3"
        android:endColor="#CCA78BFA"/>
</shape>
