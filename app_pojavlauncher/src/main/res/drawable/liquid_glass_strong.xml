<?xml version="1.0" encoding="utf-8"?>
<!-- Selected / elevated variant of the frosted panel. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/liquid_radius_card"/>
            <gradient android:angle="315"
                android:startColor="@color/liquid_glass_highlight"
                android:centerColor="@color/liquid_glass_rim_iridescent_b"
                android:endColor="@color/liquid_glass_rim_iridescent_c"
                android:type="linear"/>
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/liquid_radius_card"/>
            <gradient android:angle="270"
                android:startColor="#33FFFFFF"
                android:centerColor="#1AFFFFFF"
                android:endColor="#0DFFFFFF"
                android:centerY="0.45"
                android:type="linear"/>
        </shape>
    </item>
</layer-list>
