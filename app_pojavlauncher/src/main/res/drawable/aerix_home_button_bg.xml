<?xml version="1.0" encoding="utf-8"?>
<!-- Floating "back to Aerix home" button shown above Pojav screens (installers, editor, login, prefs). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/aerix_border">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/aerix_panel_raised_solid" />
            <stroke
                android:width="1dp"
                android:color="@color/aerix_accent" />
        </shape>
    </item>
</ripple>
