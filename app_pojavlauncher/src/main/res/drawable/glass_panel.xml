<?xml version="1.0" encoding="utf-8"?>
<!-- A Mirai glass panel: translucent blue fill, icy hairline, a faint sheen on top. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/mirai_panel"/>
            <corners android:radius="@dimen/mirai_radius_card"/>
            <stroke android:width="@dimen/mirai_gap_hairline" android:color="@color/mirai_border_soft"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="270"
                android:startColor="#14FFFFFF" android:endColor="#00FFFFFF"/>
            <corners android:radius="@dimen/mirai_radius_card"/>
        </shape>
    </item>
</layer-list>
