<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">ely.by</domain>
    </domain-config>
    <!-- The equipped skin is served to the game from the launcher itself (AerixSkinServer), and
         the game downloads that texture over http from the loopback interface. Without this the
         platform refuses the connection and the player keeps the default skin. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>