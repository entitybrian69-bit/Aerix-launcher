{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aerix.invalid/trinkies/schema/item.schema.json",
  "title": "Trinkies cosmetic item",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "category", "name", "description", "rarity", "tags",
    "model", "texture", "attach", "animations", "animation_file",
    "version", "palette", "shape"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^trinkies:[a-z0-9_]+$"},
    "category": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 64},
    "description": {"type": "string", "minLength": 1, "maxLength": 240},
    "rarity": {"enum": ["common", "epic", "legendary", "mythic", "eternal"]},
    "tags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9-]+$", "maxLength": 32}},
    "model": {"type": "string", "pattern": "^[a-zA-Z0-9_./-]+\\.bbmodel$"},
    "texture": {"type": "string", "pattern": "^[a-zA-Z0-9_./-]+\\.png$"},
    "emissive_mask": {"type": "string", "pattern": "^[a-zA-Z0-9_./-]+\\.png$"},
    "particle_sheet": {"type": "string", "pattern": "^[a-zA-Z0-9_./-]+\\.png$"},
    "attach": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bone", "offset"],
      "properties": {
        "bone": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "offset": {"$ref": "#/$defs/vector3"}
      }
    },
    "animations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
    },
    "animation_file": {"type": "string", "pattern": "^[a-zA-Z0-9_./-]+\\.json$"},
    "variant_of": {"type": "string", "pattern": "^trinkies:[a-z0-9_]+$"},
    "suit_mode": {"enum": ["overlay", "replace"]},
    "palette": {
      "type": "array",
      "minItems": 5,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"}
    },
    "shape": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "version": {"type": "integer", "const": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"category": {"const": "suit"}}, "required": ["category"]},
      "then": {"required": ["suit_mode"]}
    },
    {
      "if": {"properties": {"category": {"const": "aura"}}, "required": ["category"]},
      "then": {"required": ["particle_sheet"]}
    }
  ],
  "$defs": {
    "vector3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "number"}
    }
  }
}
