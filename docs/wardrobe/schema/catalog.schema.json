{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aerix.invalid/trinkies/schema/catalog.schema.json",
  "title": "Trinkies catalog manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "items"],
  "properties": {
    "schema": {"type": "integer", "const": 1},
    "status": {"enum": ["vertical_slice_unverified_in_game", "full_catalog_unverified_in_game"]},
    "item_count": {"type": "integer", "minimum": 1},
    "category_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hat", "suit", "back", "pet", "emote", "aura"],
      "properties": {
        "hat": {"type": "integer", "minimum": 1},
        "suit": {"type": "integer", "minimum": 1},
        "back": {"type": "integer", "minimum": 1},
        "pet": {"type": "integer", "minimum": 1},
        "emote": {"type": "integer", "minimum": 1},
        "aura": {"type": "integer", "minimum": 1}
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/catalogItem"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "full_catalog_unverified_in_game"}}, "required": ["status"]},
      "then": {
        "required": ["item_count", "category_counts"],
        "properties": {
          "item_count": {"const": 300},
          "category_counts": {"const": {"hat": 50, "suit": 50, "back": 50, "pet": 50, "emote": 50, "aura": 50}, "type": "object"},
          "items": {
            "minItems": 300,
            "maxItems": 300,
            "contains": {"type": "object", "required": ["rarity"], "properties": {"rarity": {"const": "eternal"}}},
            "minContains": 5,
            "maxContains": 5
          }
        }
      }
    }
  ],
  "$defs": {
    "catalogItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "name", "rarity", "item", "texture", "preview"],
      "properties": {
        "id": {"type": "string", "pattern": "^trinkies:[a-z0-9_]+$"},
        "category": {"enum": ["hat", "suit", "back", "pet", "emote", "aura"]},
        "name": {"type": "string", "minLength": 1, "maxLength": 64},
        "rarity": {"enum": ["common", "epic", "legendary", "mythic", "eternal"]},
        "description": {"type": "string", "minLength": 1, "maxLength": 240},
        "item": {"type": "string", "pattern": "^items/[a-z0-9_]+/item\\.json$"},
        "texture": {"type": "string", "pattern": "^items/[a-z0-9_]+/texture\\.png$"},
        "preview": {"type": "string", "pattern": "^items/[a-z0-9_]+/preview\\.png$"},
        "shape": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "palette": {
          "type": "array",
          "minItems": 5,
          "maxItems": 8,
          "items": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"}
        },
        "local_render_support": {"type": "boolean"}
      }
    }
  }
}
