{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aerix.invalid/trinkies/schema/equipped.schema.json",
  "title": "Trinkies per-instance equipped state",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "hat", "suit", "back", "aura", "pet", "emote_wheel"],
  "properties": {
    "schema": {"type": "integer", "const": 1},
    "hat": {"$ref": "#/$defs/equippedId"},
    "suit": {"$ref": "#/$defs/equippedId"},
    "back": {"$ref": "#/$defs/equippedId"},
    "aura": {"$ref": "#/$defs/equippedId"},
    "pet": {"$ref": "#/$defs/equippedId"},
    "emote_wheel": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {"$ref": "#/$defs/equippedId"}
    }
  },
  "$defs": {
    "equippedId": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^trinkies:[a-z0-9_]+$"}
      ]
    }
  }
}
