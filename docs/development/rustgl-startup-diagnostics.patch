diff --git a/app_pojavlauncher/src/main/java/net/kdt/pojavlaunch/aerix/renderer/RendererStartupDiagnostics.kt b/app_pojavlauncher/src/main/java/net/kdt/pojavlaunch/aerix/renderer/RendererStartupDiagnostics.kt
