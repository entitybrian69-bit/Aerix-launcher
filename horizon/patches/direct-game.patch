+/// Report native installation state to the Aerix Activity; empty means the game is ready.
+pub fn aerix_status(message: &str) {
+    let _ = with_context(|env, activity| {
+        let message = JObject::from(env.new_string(message)?);
+        env.call_method(activity, "aerixStatus", "(Ljava/lang/String;)V", &[JValue::Object(&message)])?;
+        Ok(())
+    });
+}
