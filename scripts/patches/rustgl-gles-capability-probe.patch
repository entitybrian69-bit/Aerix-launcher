+#[cfg(test)]
+mod aerix_probe_tests {
+    use super::*;
+
+    #[test]
+    fn driver_extension_names_match_terminated_aliases() {
+        let mut caps = GlesCapabilities::default();
+        caps.extensions.insert(b"GL_EXT_texture_filter_anisotropic".to_vec());
+        assert!(caps.has(b"GL_EXT_texture_filter_anisotropic"));
+        assert!(caps.has(b"GL_EXT_texture_filter_anisotropic\0"));
+        assert!(caps.has(b"GL_EXT_texture_filter_anisotropic\0\0"));
+        assert!(!caps.has(b"GL_EXT_not_supported\0"));
+    }
