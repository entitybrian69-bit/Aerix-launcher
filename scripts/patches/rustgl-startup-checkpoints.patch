+// Opt-in Aerix diagnostics, bounded per EGL operation. No signals are intercepted.
+fn aerix_startup_event(counter: &std::sync::atomic::AtomicU32, limit: u32) -> bool {
+    static ENABLED: OnceLock<bool> = OnceLock::new();
+    if !*ENABLED.get_or_init(|| std::env::var("AERIX_RENDERER_STARTUP_TRACE").as_deref() == Ok("1")) {
+        return false;
+    }
+    // Saturating: never wrap and start printing again after many frames.
+    counter.fetch_update(Ordering::Relaxed, Ordering::Relaxed,
+        |value| if value < limit { Some(value + 1) } else { None }).is_ok()
 }
 
